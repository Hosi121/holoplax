{
  "name": "holoplax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "lint": "biome check . && npm run check:architecture",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seed": "node scripts/seed-dev.mjs",
    "bot:discord": "npm run discord --workspace bots",
    "bot:slack": "npm run slack --workspace bots",
    "discord:deploy": "npm run discord:deploy --workspace bots --",
    "maintenance:cleanup-orphans": "node scripts/cleanup-orphans.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace mcp-server",
    "build:mcp": "npm run build --workspace mcp-server",
    "pretypecheck": "node scripts/generate-routes.mjs",
    "pretest:run": "node scripts/generate-routes.mjs"
  },
  "prisma": {
    "seed": "npm run seed"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "clsx": "2.1.1",
    "lucide-react": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.6.0",
    "zustand": "^5.0.10",
    "react-router": "7.18.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.0.18",
    "lefthook": "^2.0.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "prisma": "5.20.0",
    "vite": "7.3.1",
    "esbuild": "0.27.2",
    "tsx": "^4.21.0",
    "@holoplax/server": "*"
  },
  "workspaces": [
    "packages/runtime",
    "mcp-server",
    "bots",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
