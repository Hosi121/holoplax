{
  "name": "holoplax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "wrangler dev",
    "lint": "biome check . && npm run check:architecture",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seed": "npm run db:migrate && node --import tsx scripts/seed-dev.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace mcp-server",
    "build:mcp": "npm run build --workspace mcp-server",
    "pretypecheck": "node scripts/generate-routes.mjs",
    "pretest:run": "node scripts/generate-routes.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "cf:types": "wrangler types --include-runtime false --strict-vars false",
    "check:cf-types": "node scripts/check-cf-types.mjs",
    "check:metrics": "python3 scripts/metrics-oracle.py --check"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "clsx": "2.1.1",
    "lucide-react": "^0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.6.0",
    "zustand": "^5.0.10",
    "react-router": "7.18.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "miniflare": "5.20261006.1-alpha",
    "@cloudflare/workers-types": "5.20261008.1",
    "@biomejs/biome": "^2.3.11",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "lefthook": "^2.0.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11",
    "vite": "7.3.7",
    "esbuild": "0.27.2",
    "tsx": "^4.21.0",
    "@holoplax/server": "*"
  },
  "workspaces": [
    "packages/runtime",
    "mcp-server",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
