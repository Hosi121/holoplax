{
  "name": "holoplax-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for holoplax application",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "typecheck": "tsc",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "zod": "^4.3.5",
    "@holoplax/runtime": "*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "esbuild": "0.27.2",
    "typescript": "^5"
  }
}
